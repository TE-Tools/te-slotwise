# TE-Slotwise – Beispielkonfiguration (lokaler Node-Betrieb; online siehe wrangler.toml). Kopieren nach ".env" und anpassen.
# Keine echten Geheimnisse in diese Datei schreiben – .env ist von Git ausgeschlossen.

# Öffentliche Adresse der Anwendung (für Links in E-Mails und Teilen-Links).
APP_URL=http://localhost:3000
PORT=3000

# Pfad der SQLite-Datenbankdatei (Ordner wird angelegt).
DATABASE_PATH=./data/slotwise.db

# E-Mail-Versand über Resend (empfohlen):
# RESEND_API_KEY=re_...

# Alternativ SMTP. Ohne RESEND_API_KEY/SMTP_URL wird KEINE E-Mail versendet; das wird in der
# Oberfläche ehrlich angezeigt. Format: smtp(s)://BENUTZER:PASSWORT@HOST:PORT
# SMTP_URL=smtps://benutzer:passwort@smtp.example.com:465
MAIL_FROM="Slotwise <noreply@example.com>"

# Nur für lokale Entwicklung: E-Mails nicht senden, sondern in der Konsole ausgeben.
# MAIL_TRANSPORT=console

# Nur für lokale Entwicklung: Anmeldelinks direkt auf der Seite anzeigen,
# wenn kein Versand eingerichtet ist. Wird bei NODE_ENV=production ignoriert.
# DEV_LOGIN_LINKS=1

# Hinter einem Reverse-Proxy (z. B. nginx, Caddy): Client-IP aus X-Forwarded-For lesen.
# TRUST_PROXY=1

# Betreiberangaben für Impressum/Datenschutz (Adresszeilen mit | trennen)
# OPERATOR_NAME="Firma|Inhaber: Vorname Nachname"   („|“ = Zeilenumbruch)
# OPERATOR_ADDRESS="Straße 1|12345 Ort"
# OPERATOR_EMAIL=kontakt@example.com
